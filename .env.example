# ─── GateXPay Environment Configuration ─────────────────

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.l7xeac9.mongodb.net/gatexpay?retryWrites=true&w=majority

# App & Authentication
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=GateXPay
AUTH_SECRET=your-super-secret-jwt-and-session-key-minimum-32-characters

# Admin Seed
SEED_ADMIN_EMAIL=admin@gatexpay.com
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_NAME=Super Admin

# Admin Email Notifications (Resend API)
ADMIN_EMAIL=admin@gatexpay.com
EMAIL_FROM=notifications@gatexpay.com
RESEND_API_KEY=re_your_resend_api_key_here

# ImageKit CDN
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=ik.imagekit.io/your_endpoint

# AI Chatbot
GEMINI_API_KEY=your_gemini_api_key
